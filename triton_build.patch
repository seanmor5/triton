@@ -13,4 +13,6 @@ add_triton_library(ProtonGPUToLLVM
 )
 
 add_subdirectory(ProtonNvidiaGPUToLLVM)
-add_subdirectory(ProtonAMDGPUToLLVM)
+if("amd" IN_LIST TRITON_CODEGEN_BACKENDS)
+  add_subdirectory(ProtonAMDGPUToLLVM)
